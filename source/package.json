{
  "name": "ide-beta",
  "version": "1.0.0-beta.14",
  "description": "Desktop dashboard for Arduino Uno",
  "main": "main.js",
  "scripts": {
    "build:collab": "node scripts/build-collaboration.cjs",
    "prestart": "npm run build:collab",
    "predist": "npm run build:collab",
    "predist:win": "npm run build:collab",
    "predist:linux": "npm run build:collab",
    "precheck:ui": "npm run build:collab",
    "collab:server": "node collaboration/server.cjs",
    "collab:bundle": "node scripts/package-server.cjs",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage tar.gz deb rpm --x64",
    "check:ui": "electron scripts/smoke.cjs",
    "test": "node --test scripts/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "0.25.12"
  },
  "build": {
    "appId": "com.unobench.app",
    "productName": "IDE-beta",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "workspace.js",
      "collaboration-ui.js",
      "collaboration.bundle.js",
      "collaboration/*.cjs",
      "firmware.cjs",
      "icon.png",
      "fonts/**/*",
      "native-serial.cjs",
      "serial-runtime.js"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "IDE-beta.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "icon.png",
      "executableName": "ide-beta",
      "artifactName": "IDE-beta-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "IDE-beta-linux-amd64.deb",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnss3",
        "libasound2t64 | libasound2 (>= 1.0.16)",
        "libgbm1",
        "libxss1",
        "libxtst6",
        "libx11-xcb1",
        "libdrm2",
        "libxkbcommon0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libcups2t64 | libcups2",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "xdg-utils",
        "ca-certificates"
      ]
    },
    "rpm": {
      "artifactName": "IDE-beta-linux-x86_64.rpm",
      "afterRemove": "scripts/linux-after-remove.sh",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "mesa-libgbm",
        "libXScrnSaver",
        "libXtst",
        "libdrm",
        "libxkbcommon",
        "cups-libs",
        "at-spi2-atk",
        "libX11",
        "libxcb",
        "libXcomposite",
        "libXdamage",
        "libXfixes",
        "libXrandr",
        "xdg-utils",
        "ca-certificates"
      ]
    }
  },
  "author": {
    "name": "misterlikyy",
    "email": "misterlikyy@users.noreply.github.com"
  },
  "homepage": "https://github.com/misterlikyy/Homebrew_IDE",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true,
    "@serialport/bindings-cpp@13.0.0": true
  },
  "dependencies": {
    "serialport": "13.0.0",
    "ws": "8.23.1",
    "yjs": "13.6.33"
  }
}
